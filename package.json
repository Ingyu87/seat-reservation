{
  "name": "seat-reservation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:admin": "npm run dev --workspace @seat/admin",
    "build": "next build && npm run build --workspace @seat/admin",
    "build:admin": "npm run build --workspace @seat/admin",
    "start": "next start",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @seat/admin"
  },
  "dependencies": {
    "@seat/shared": "*",
    "firebase": "12.12.0",
    "next": "15.5.16",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
